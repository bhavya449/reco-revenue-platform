# ==============================================================================
# RECO PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# Application Base URL (Used for "Open RECO" button in emails)
APP_URL=http://localhost:8080

# ==============================================================================
# 📧 OPTION 1: RESEND API (Recommended — Fastest & Most Reliable Setup)
# 1. Sign up for free at https://resend.com
# 2. Get an API key from https://resend.com/api-keys
# 3. Paste your API key below:
# ==============================================================================
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=RECO Onboarding <onboarding@resend.dev>

# ==============================================================================
# 📧 OPTION 2: UNIVERSAL SMTP (Gmail, SendGrid, Amazon SES, Mailgun, Postmark)
# If you prefer using standard SMTP instead of Resend, uncomment and fill:
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# EMAIL_FROM=RECO Platform <your-email@gmail.com>
